#!/usr/bin/env bash

export TMPDIR="$XDG_RUNTIME_DIR/app/${FLATPAK_ID:-com.t3tools.t3code}"
# Android is opt-in. Prefer an explicit SDK, including a deliberately mounted
# read-only host SDK, and otherwise use the app-private setup helper's SDK.
android_data="${XDG_DATA_HOME:-$HOME/.local/share}/t3code/android"
private_android_sdk="$android_data/sdk/current"
if [[ -n "${ANDROID_HOME:-}" ]]; then
    : "${ANDROID_SDK_ROOT:=$ANDROID_HOME}"
    export ANDROID_SDK_ROOT
elif [[ -n "${ANDROID_SDK_ROOT:-}" ]]; then
    export ANDROID_HOME="$ANDROID_SDK_ROOT"
elif [[ -d "$private_android_sdk" ]]; then
    export ANDROID_HOME="$private_android_sdk"
    export ANDROID_SDK_ROOT="$private_android_sdk"
fi
if [[ -n "${ANDROID_HOME:-}" ]]; then
    # The device hub adds its own `-gpu auto` before these extra arguments.
    # Put swangle first so any explicit user GPU option later in the value wins.
    export EXPO_DEVICE_HUB_EMULATOR_EXTRA_ARGS="-gpu swangle${EXPO_DEVICE_HUB_EMULATOR_EXTRA_ARGS:+ $EXPO_DEVICE_HUB_EMULATOR_EXTRA_ARGS}"
    export ANDROID_USER_HOME="${ANDROID_USER_HOME:-$android_data/user}"
    export ANDROID_AVD_HOME="${ANDROID_AVD_HOME:-$ANDROID_USER_HOME/avd}"
    mkdir -p "$ANDROID_USER_HOME" "$ANDROID_AVD_HOME"
    export PATH="$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator:$PATH"
fi
if [[ -n "${JAVA_HOME:-}" ]]; then
    export PATH="$JAVA_HOME/bin:$PATH"
elif [[ -x "$android_data/java/current/bin/java" ]]; then
    export JAVA_HOME="$android_data/java/current"
    export PATH="$JAVA_HOME/bin:$PATH"
fi
unset android_data private_android_sdk
export NPM_CONFIG_PREFIX="${XDG_DATA_HOME:-$HOME/.local/share}/npm-global"
export NPM_CONFIG_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/npm"
# Flatpak mounts optional tool extensions but does not add their commands to
# PATH. Keep npm and bundled commands ahead of extension commands.
tools_path=""
for tool_bin in /app/tools/*/bin; do
    [[ -d "$tool_bin" ]] && tools_path+=":$tool_bin"
done
# Native installers (Claude Code's install.sh) keep their launchers in
# ~/.local/bin. --persist=.local/bin makes that app-private storage; add it
# first so a native install wins over an older npm one. Skip it when it is the
# host directory instead (a --filesystem=home override disables --persist).
local_bin=""
app_local_bin="$HOME/.var/app/${FLATPAK_ID:-com.t3tools.t3code}/.local/bin"
mkdir -p "$app_local_bin"
[[ "$HOME/.local/bin" -ef "$app_local_bin" ]] && local_bin="$HOME/.local/bin:"
export PATH="$local_bin$NPM_CONFIG_PREFIX/bin:/app/bin$tools_path:$PATH"
unset tools_path tool_bin local_bin app_local_bin

mkdir -p "$NPM_CONFIG_PREFIX" "$NPM_CONFIG_CACHE"

# Anything written to $HOME outside ~/.var/app/$FLATPAK_ID and the --persist
# dirs in the manifest is lost when the sandbox exits. Steer remaining
# home-relative state into persistent locations. Host credentials and tools
# are not exposed by the manifest.

# Claude Code keeps ~/.claude.json next to (not inside) ~/.claude unless
# CLAUDE_CONFIG_DIR is set. Point it at the persisted ~/.claude so the file
# lands there too.
export CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"

# `git config --global` writes to $XDG_CONFIG_HOME/git/config instead of
# ~/.gitconfig when the former exists and the latter does not.
git_xdg_config="${XDG_CONFIG_HOME:-$HOME/.config}/git/config"
mkdir -p "$(dirname -- "$git_xdg_config")"
[[ -e "$git_xdg_config" ]] || : > "$git_xdg_config"

# Older Flatpak clients do not set XDG_STATE_HOME. Keep their shell history
# under app-private persistent storage too, rather than the temporary home.
export HISTFILE="${HISTFILE:-${XDG_STATE_HOME:-$HOME/.var/app/${FLATPAK_ID:-com.t3tools.t3code}/.local/state}/bash/history}"
mkdir -p "$(dirname -- "$HISTFILE")"

declare -a FLAGS=()

if [[ -n "$WAYLAND_DISPLAY" ]]; then
    if [[ -c /dev/nvidia0 ]]; then
        echo "Using NVIDIA on Wayland, disabling gpu sandbox"
        FLAGS+=(--disable-gpu-sandbox)
    fi

    echo "Running on native Wayland"
    FLAGS+=(--ozone-platform-hint=auto)
    FLAGS+=(--enable-wayland-ime)
    FLAGS+=(--wayland-text-input-version=3)
else
    echo "Running on X11"
fi

echo "Passing the following arguments to Electron:" "${FLAGS[@]}" "$@"
zypak-wrapper /app/bin/t3code/t3code "${FLAGS[@]}" "$@"
