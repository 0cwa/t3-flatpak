#!/usr/bin/env bash

export TMPDIR="$XDG_RUNTIME_DIR/app/${FLATPAK_ID:-com.t3tools.t3code}"
export NPM_CONFIG_PREFIX="${XDG_DATA_HOME:-$HOME/.local/share}/npm-global"
export NPM_CONFIG_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/npm"
export PATH="$HOME/.local/bin:$NPM_CONFIG_PREFIX/bin:/app/bin:$PATH"

mkdir -p "$NPM_CONFIG_PREFIX" "$NPM_CONFIG_CACHE"

# Anything written to $HOME outside ~/.var/app/$FLATPAK_ID and the --persist
# dirs in the manifest is lost when the sandbox exits. Steer remaining
# home-relative state into persistent locations. Selected host directories are
# mounted read-only by the manifest.

# Claude Code keeps ~/.claude.json next to (not inside) ~/.claude unless
# CLAUDE_CONFIG_DIR is set. Point it at the persisted ~/.claude so the file
# lands there too.
export CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"

# `git config --global` writes to $XDG_CONFIG_HOME/git/config instead of
# ~/.gitconfig when the former exists and the latter does not.
git_xdg_config="${XDG_CONFIG_HOME:-$HOME/.config}/git/config"
mkdir -p "$(dirname -- "$git_xdg_config")"
[[ -e "$git_xdg_config" ]] || : > "$git_xdg_config"

# Shell history for T3 Code terminals.
export HISTFILE="${HISTFILE:-${XDG_STATE_HOME:-$HOME/.local/state}/bash/history}"
mkdir -p "$(dirname -- "$HISTFILE")"

declare -a FLAGS=()

if [[ -n "$WAYLAND_DISPLAY" ]]; then
    if [[ -c /dev/nvidia0 ]]; then
        echo "Using NVIDIA on Wayland, disabling gpu sandbox"
        FLAGS+=(--disable-gpu-sandbox)
    fi

    echo "Running on native Wayland"
    FLAGS+=(--ozone-platform-hint=auto)
    FLAGS+=(--enable-wayland-ime)
    FLAGS+=(--wayland-text-input-version=3)
else
    echo "Running on X11"
fi

echo "Passing the following arguments to Electron:" "${FLAGS[@]}" "$@"
zypak-wrapper /app/bin/t3code/t3code "${FLAGS[@]}" "$@"
